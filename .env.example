APP_ENV=development
APP_NAME=LearnOS
DEBUG=true
LOG_LEVEL=DEBUG

DATABASE_URL=postgresql+asyncpg://learnos:learnos@postgres:5432/learnos
TEST_DATABASE_URL=postgresql+asyncpg://learnos:learnos@postgres:5432/learnos_test

REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=["http://localhost:3000"]

# Database pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
